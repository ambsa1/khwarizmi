{
  "$schema": "../../schemas/tokens.schema.json",
  "color": {
    "sand": "#F4E3C1",
    "sandDeep": "#E7C98F",
    "sandLine": "#E0CBA0",
    "card": "#FFFBF3",
    "ink": "#2B2118",
    "inkSoft": "#6B5A48",
    "white": "#FFFFFF",
    "gold": "#FFB627",
    "goldShadow": "#C7861A",
    "glow": "#FFE08A",
    "nile": "#1F5FAD",
    "nileShadow": "#164682",
    "nileLight": "#D9EEF7",
    "success": "#1A7F50",
    "successShadow": "#12583A",
    "successLight": "#2FA36B",
    "retry": "#7B61C9",
    "retryShadow": "#5A4596",
    "clay": "#D9643A",
    "night": "#1B2340",
    "nightSoft": "#2C3760"
  },
  "contrast": [
    { "fg": "ink", "bg": "sand", "min": 7, "use": "main text on the app background" },
    { "fg": "inkSoft", "bg": "sand", "min": 4.5, "use": "secondary text" },
    { "fg": "ink", "bg": "card", "min": 7, "use": "text on cards" },
    { "fg": "inkSoft", "bg": "card", "min": 4.5, "use": "secondary text on cards" },
    { "fg": "ink", "bg": "gold", "min": 4.5, "use": "primary button label" },
    { "fg": "white", "bg": "nile", "min": 4.5, "use": "navigation and headers" },
    { "fg": "white", "bg": "success", "min": 4.5, "use": "success button label" },
    { "fg": "white", "bg": "retry", "min": 4.5, "use": "try-again label" },
    { "fg": "white", "bg": "night", "min": 7, "use": "text on night panels" },
    { "fg": "glow", "bg": "night", "min": 4.5, "use": "lamp-gold text on night panels" },
    { "fg": "nile", "bg": "sand", "min": 4.5, "use": "links and selected tabs" },
    { "fg": "ink", "bg": "nileLight", "min": 7, "use": "text on light blue chips" }
  ],
  "worlds": {
    "kassala": { "primary": "#C98B7A", "secondary": "#3E9B4F", "ground": "#E9CF9E", "water": "#5CB8D6", "skyTop": "#F7A26B", "skyBottom": "#FFC98B" },
    "mogran": { "primary": "#1F4E8C", "secondary": "#5DAA5A", "ground": "#D8C49A", "water": "#CFE3E8", "skyTop": "#7FB8E6", "skyBottom": "#E8F3F8" },
    "meroe": { "primary": "#B5714A", "secondary": "#E89A4B", "ground": "#E9B072", "water": "#6FB7C9", "skyTop": "#F6B38A", "skyBottom": "#FFE3B3" },
    "suakin": { "primary": "#F3EDE2", "secondary": "#8A5A3B", "ground": "#E8DCC4", "water": "#2EC4C4", "skyTop": "#6FC8E8", "skyBottom": "#E6F7FA" },
    "marra": { "primary": "#2E7D4F", "secondary": "#4A4A48", "ground": "#6FA65A", "water": "#2F8FBF", "skyTop": "#9CC9D9", "skyBottom": "#E6F2EC" },
    "saqiya": { "primary": "#C46A3C", "secondary": "#4FA35A", "ground": "#E2C792", "water": "#4FA3D1", "skyTop": "#8FCBEA", "skyBottom": "#FDF1D6" }
  },
  "type": {
    "families": {
      "display": "Lalezar",
      "ui": "Rubik",
      "readAr": "Noto Naskh Arabic",
      "readEn": "Andika"
    },
    "scale": [
      { "id": "display", "size": 48, "line": 56, "family": "display", "weight": 400 },
      { "id": "h1", "size": 36, "line": 44, "family": "display", "weight": 400 },
      { "id": "h2", "size": 28, "line": 36, "family": "ui", "weight": 700 },
      { "id": "button", "size": 24, "line": 32, "family": "ui", "weight": 700 },
      { "id": "lead", "size": 22, "line": 34, "family": "ui", "weight": 500 },
      { "id": "body", "size": 18, "line": 28, "family": "ui", "weight": 500 },
      { "id": "readAr", "size": 28, "line": 48, "family": "readAr", "weight": 500 },
      { "id": "readEn", "size": 28, "line": 40, "family": "readEn", "weight": 400 },
      { "id": "small", "size": 16, "line": 22, "family": "ui", "weight": 500, "parentsOnly": true }
    ],
    "childMin": 18
  },
  "space": [4, 8, 16, 24, 32, 48, 64],
  "radius": { "card": 24, "button": 20, "chip": 14, "pill": 999 },
  "touch": { "little": 72, "big": 56 },
  "depth": { "button": 6, "card": 4 },
  "motion": { "tap": 100, "card": 250, "screen": 350, "celebrate": 2000, "maxBlock": 600 }
}
