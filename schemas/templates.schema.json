{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khawarizmi.local/schemas/templates.schema.json",
  "title": "Registry of reusable activity templates",
  "type": "object",
  "required": ["templates"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "title", "domains"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "family": { "enum": ["world-3d", "manipulative", "simulation", "language", "puzzle", "editor", "sorting"] },
          "title": { "$ref": "defs.schema.json#/$defs/text" },
          "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/$defs/domain" } },
          "minAge": { "$ref": "defs.schema.json#/$defs/age" }
        }
      }
    }
  }
}
