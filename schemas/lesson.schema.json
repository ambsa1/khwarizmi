{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khawarizmi.local/schemas/lesson.schema.json",
  "title": "One lesson (school or future skills)",
  "type": "object",
  "required": ["id", "skills", "keyCards", "activities", "quiz", "status"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "defs.schema.json#/$defs/id" },
    "title": { "$ref": "defs.schema.json#/$defs/text" },
    "status": { "enum": ["draft", "approved"] },
    "skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/$defs/skillId" } },
    "reviews": { "type": "array", "uniqueItems": true, "items": { "$ref": "defs.schema.json#/$defs/skillId" } },
    "keyCards": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "required": ["text", "visual"], "additionalProperties": false,
        "properties": {
          "text": { "$ref": "defs.schema.json#/$defs/text" },
          "visual": { "$ref": "defs.schema.json#/$defs/id" },
          "voice": { "$ref": "defs.schema.json#/$defs/id" }
        }
      }
    },
    "workedExamples": {
      "type": "array",
      "items": {
        "type": "object", "required": ["question", "steps", "answer"], "additionalProperties": false,
        "properties": {
          "question": { "$ref": "defs.schema.json#/$defs/text" },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "defs.schema.json#/$defs/text" } },
          "answer": { "$ref": "defs.schema.json#/$defs/text" }
        }
      }
    },
    "activities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["template"], "additionalProperties": false,
        "properties": {
          "template": { "$ref": "defs.schema.json#/$defs/id" },
          "params": { "type": "object" },
          "rounds": { "type": "integer", "minimum": 1, "maximum": 20 },
          "mode": { "enum": ["guided", "predict", "modify", "create", "debug", "challenge"] }
        }
      }
    },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type", "q"],
        "properties": {
          "type": { "enum": ["choose", "order", "match", "input", "drag", "speak"] },
          "q": { "$ref": "defs.schema.json#/$defs/text" }
        }
      }
    },
    "source": {
      "type": "object", "required": ["id", "pages"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "pages": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
      }
    }
  }
}
